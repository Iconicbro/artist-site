# Copy this file to .env and fill in what you need. Never commit .env.

# Stripe secret key. Use a TEST key (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=

# Real email sending (optional). Without it, emails are only saved and shown in the admin.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Madscope Store <orders@your-domain.com>

# Your public web address once the store is online (used in emails and Stripe links).
# PUBLIC_URL=https://store.example.com

# Port to run on (default 3000)
# PORT=3000

# Admin login created the first time the store starts (or when you run `npm run seed`).
# ADMIN_EMAIL=owner@madscope.shop
# ADMIN_PASSWORD=stackpaper2026
